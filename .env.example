# Copy to .env (git-ignored) and fill in. Command-line flags and the process
# environment override these values.
#
# App Store Connect → Users and Access → Integrations → App Store Connect API → Team Keys
# Use a key with the Admin role (needed to create report requests).
ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# The .p8 contents on ONE line, quoted, with each newline written as \n:
ASC_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIG...\n-----END PRIVATE KEY-----"

# Fallback: a path to the .p8 instead. ASC_PRIVATE_KEY wins if both are set.
# ASC_PRIVATE_KEY_PATH=~/Keys/AuthKey_XXXXXXXXXX.p8

# Optional defaults
# ASC_APP=com.example.App
# ASC_REPORTS_DIR=Reports
